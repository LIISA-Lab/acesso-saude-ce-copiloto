{
  "manifest_version": 3,
  "name": "Copiloto Acesso Saúde CE",
  "version": "1.0.0",
  "description": "Assistente virtual para Telessaúde CE",

"icons": {
  "16": "ui/images/logo_liisa.png",
  "32": "ui/images/logo_liisa.png",
  "48": "ui/images/logo_liisa.png",
  "128": "ui/images/logo_liisa.png"
},

  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://teleatendimento.vercel.app/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["*://teleatendimento.vercel.app/*", "<all_urls>"],
      "js": ["scripts/stt_engine.js", "scripts/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "Abrir Copiloto"
  },
  "side_panel": {
    "default_path": "ui/panel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["pkg/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://generativelanguage.googleapis.com http://localhost:3000 https://34-95-176-162.sslip.io"
  }
}
