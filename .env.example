# Chave da API do Gemini (obrigatória para a integração com LLM)
GEMINI_API_KEY=SUA_CHAVE_AQUI

# Modelo do Gemini (opcional, padrão: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Telemetria Langfuse (opcional; sem host/chaves fica desligada).
# Para outro host, inclua-o também no connect-src do extension/manifest.json.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Separa os dados na UI: development, homologacao, avaliacao...
LANGFUSE_ENVIRONMENT=development
# false = não envia prompts/respostas, só tokens, latência e erros
LANGFUSE_CAPTURE_CONTENT=true
